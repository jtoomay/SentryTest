# Copy to server/.env and fill in.
# DSN from Sentry > Settings > Projects > (your Node/Express project) > Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_RELEASE=sentry-showcase@1.0.0

# 1.0 = trace every request. Fine for a demo; lower it if you get close to your quota.
SENTRY_TRACES_SAMPLE_RATE=1.0

# The scheduled cron job checks in every 5 minutes and fails about 30% of the time.
# It's off by default to protect the Developer-tier error quota. You can always
# trigger a single check-in from the UI (Context page) instead.
SENTRY_CRON_ENABLED=false

PORT=4000
