# Copy to client/.env and fill in.
# DSN from Sentry > Settings > Projects > (your React project) > Client Keys (DSN)
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development
VITE_SENTRY_RELEASE=sentry-showcase@1.0.0

# Your org slug (the part before .sentry.io). Used for "Open in Sentry" links in the UI.
VITE_SENTRY_ORG=

# 1.0 = trace every page load and action.
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
# Replays of normal sessions. The Developer tier includes 50 replays/month, so keep this low.
# Sessions that hit an error are always recorded, whatever this is set to.
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0

# --- Source map upload (only used by `npm run build`) ---
# Create a token at Sentry > Settings > Auth Tokens (org token with project:releases scope).
# Leave it blank to build without uploading.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
